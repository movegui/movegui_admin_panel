rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
      /*
        && (
      request.auth.token.role == "Admin" 
      
      );
      */
    }

    function isSuperAdmin() {
      return request.auth != null
      /*
        && request.auth.token.role == "SuperAdmin";
        */
    }

    function isOwner(id) {
      return request.auth.uid == id;
    }

    match /users_collection/{id} {

      allow create , delete: if isSignedIn()  // && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn()
      //     && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update: if isSignedIn() // && isSuperAdmin()
      //   && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /pressings_collection/{id} {
      allow create: if isSignedIn()
      //      && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() 
      // && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
      //   && (isOwner(id) || isAdmin() || isSuperAdmin());
      match /services/{serviceId} {
        allow create: if isSignedIn()
          && ( isAdmin() || isSuperAdmin());

        allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

        allow update, delete: if isSignedIn()
          && (isOwner(id) || isAdmin() || isSuperAdmin());
      }

            match /cart/{cartId} {
        allow create: if isSignedIn()
          && ( isAdmin() || isSuperAdmin());

        allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

        allow update, delete: if isSignedIn()
          && (isOwner(id) || isAdmin() || isSuperAdmin());
      }
    }

    match /suppliers_collection/{id} {

      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
        && (isOwner(id) || isAdmin() || isSuperAdmin());
    }
    match /superMarkts_collection/{id} {
      allow create: if isSignedIn()
      //    && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() 
      //&& (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
      //   && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /patisseries_collection/{id} {

      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
        && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /professionnels_collectionl/{id} {

      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
        && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /restaurants_collection/{id} {

      allow create: if isSignedIn()
      //   && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() 
      // && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
      //    && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /ingredients_collection/{id} {

      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
        && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /categories_collection/{id} {
      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
        && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /recipes_collection/{id} {

      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
        && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /products_collection/{id} {

      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
        && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /restaurants_menu_collection/{id} {
      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
        && (isOwner(id) || isAdmin() || isSuperAdmin());
    }



    match /restaurant_type_collection/{id} {

      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
        && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /pressing_services_types_collection/{id} {
      allow read, create, update, delete: if isSignedIn()
        && (isAdmin() || isSuperAdmin());
    }


        match /establishment_members_collection/{id} {
      allow read, create, update, delete: if isSignedIn()
        && (isAdmin() || isSuperAdmin());
    }

            match /establishment_dicovery_collection/{id} {
      allow read, create, update, delete: if isSignedIn()
        && (isAdmin() || isSuperAdmin());
    }




    match /store_category_model/{id} {

      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
        && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /managers/{id} {

      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
        && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /drivers_collection/{id} {

      allow create: if isSignedIn()
      //   && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn() 
      // && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
      //     && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /orders_collection/{id} {

      allow create: if isSignedIn()
        && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn()
      // && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
      //   && (isOwner(id) || isAdmin() || isSuperAdmin());
    }
    

    match /drivers_collection/{id} {
      allow read: if isAdmin() || isSuperAdmin();
    }

    match /orders_collection/{id} {
      allow read: if isAdmin() || isSuperAdmin();
    }

    match /pressing_orders/{id} {

      allow create: if isSignedIn()
      //     && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn()
      //  && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
      //  && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /activity_logs/{id} {

      allow create: if isSignedIn()
      //     && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn()
      //  && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
      //  && (isOwner(id) || isAdmin() || isSuperAdmin());
    }

    match /pharmacies_collection/{id} {

      allow create: if isSignedIn()
      //     && ( isAdmin() || isSuperAdmin());

      allow read: if isSignedIn()
      //  && (isOwner(id) || isAdmin() || isSuperAdmin());

      allow update, delete: if isSignedIn()
      //  && (isOwner(id) || isAdmin() || isSuperAdmin());
    }
  }

}


